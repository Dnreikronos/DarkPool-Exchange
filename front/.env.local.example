# Trading-app runtime config — read and validated by front/lib/config.ts.
# Copy this file to front/.env.local and adjust the values; .env.local is
# git-ignored. The app refuses to boot if a required variable is missing.

# When true, every backend call is served by in-memory mocks (Phase 1 default).
# Set to false to run against a real dp-api + on-chain contracts.
NEXT_PUBLIC_USE_MOCKS=true

# Backend base URL. In `npm run dev` requests to /api/v1/* are proxied here
# (via next.config.mjs) until C2 lands proper CORS on the REST router.
# No trailing /v1 — the proxy appends it.
NEXT_PUBLIC_DARKPOOL_API_URL=http://localhost:8080

# Static API key sent as `x-api-key` by the SDK. Per-user auth (SIWE) is
# post-MVP.
NEXT_PUBLIC_DARKPOOL_API_KEY=darkpool-dev-key

# EVM chain id the wallet must be on. Anvil default = 31337.
NEXT_PUBLIC_CHAIN_ID=31337

# Operator-pubkey endpoint (returns the ECIES key used to encrypt orders).
# Lands with C1 (#81); placeholder URL is fine while mocks are on.
NEXT_PUBLIC_OPERATOR_PUBKEY_URL=http://localhost:8080/v1/operator/pubkey

# Contract addresses — only validated when NEXT_PUBLIC_USE_MOCKS=false.
# Replace with the addresses from contracts/deployments/<chainId>.json
# (published by C4 / #84). Anvil placeholders below.
NEXT_PUBLIC_DARKPOOL_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_VERIFIER_PROXY_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_USDC_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_WETH_ADDRESS=0x0000000000000000000000000000000000000000
