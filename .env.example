# --- Postgres ---
POSTGRES_USER=darkpool
POSTGRES_PASSWORD=darkpool
POSTGRES_DB=darkpool
POSTGRES_PORT=5432

# --- darkpool-server (DARKPOOL_*; see crates/dp-api/src/config.rs) ---
DARKPOOL_GRPC_PORT=9090
DARKPOOL_HTTP_PORT=8080
DARKPOOL_AUCTION_INTERVAL=5s
DARKPOOL_API_KEYS=
DARKPOOL_RATE_LIMIT=10
DARKPOOL_RATE_BURST=20
DARKPOOL_RATE_STALE_AFTER=10m
DARKPOOL_OPERATOR_KEY=
# Set to /usr/local/bin/dp-aggregator under --profile zk to enable proof generation.
DARKPOOL_AGGREGATOR_BIN=
DARKPOOL_AGGREGATOR_TIMEOUT=30s
# Set to /keys under --profile zk after running the keygen one-shot.
DARKPOOL_ZK_PROVING_KEY=
DARKPOOL_ZK_BATCH_SIZE=8
DARKPOOL_SUBMIT_TIMEOUT=0s
DARKPOOL_SUBMIT_GAS=500000
DARKPOOL_CHAIN_ID=31337
RUST_LOG=info,dp_event=debug,dp_engine=info

# --- Anvil + deployer ---
ANVIL_PORT=8545
# First default anvil dev key — never reuse on a real chain.
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
FEE_RECIPIENT=0xf39Fd6e51aad88F6F4ce6aB8827279cfFFb92266
